rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person can only read and write their own Questly data.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Apple Health inbox. The iPhone Shortcut writes here using a long random
    // key that only you have (shown in Questly > Profile > Apple Health), and
    // the app reads it back. Documents cannot be listed, only opened by key.
    match /health/{key} {
      allow get, create, update: if key.size() >= 24 && key.size() <= 64
        && (request.method == 'get' || request.resource.data.size() <= 10);
    }
  }
}
